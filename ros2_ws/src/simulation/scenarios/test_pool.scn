<?xml version="1.0"?>
<scenario>

	<robot name="MyROV" fixed="false">
		<base_link name="Frame" type="model" physical="submerged">
    			<mesh filename="frame.obj" scale="1.0"/>
	    		<material naVme="Aluminium"/>
	    		<look name="Grey"/>
	    		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
	    		<mass value="12.0"/>
	    		<inertia ixx="0.15" iyy="0.20" izz="0.18"/>
	    		<cg xyz="0.0 0.0 0.02"/>
	  	</base_link>

	  <actuator name="Thruster1" type="thruster">
		  
		  <specs thrust_coeff="0.45" thrust_coeff_backward="0.35" torque_coeff="0.02" max_rpm="3500" inverted="false"/>
	    	  <propeller diameter="0.076" right="true">
	      	  <mesh filename="propeller.obj" scale="1.0"/>
	      	  <material name="Steel"/>
	      	  <look name="Black"/>
	    	  </propeller>
	    	  <origin xyz="0.15 0.10 0.0" rpy="0.0 0.0 0.7854"/>
    		  <link name="Frame"/>
  		</actuator>

  		
	</robot>
    <looks>

        <look name="PoolTexture" gray="1.0" roughness="1.0" metalness="0.1" texture="test_pool/texture/PoolTexture.png"/>
																		<!-- normal_map="wind_turbine_complex/texture/SubPile_Normal.png"/> -->
		<look name="Wall" rgb="0.78 0.75 0.65" roughness="1.0" metalness="0.1"/>
		<look name="Alluminium" rgb="0.73 0.75 0.76" roughness="1.0" metalness="1.0"/>
		<look name="Black" rgb="0.0 0.0 0.0" roughness="1.0" metalness="0.1"/>
		<look name="Gray" rgb="0.5 0.5 0.5" roughness="1.0" metalness="0.1"/>

    </looks>   

	<static name="Pool" type="model">
		<physical>
			<mesh filename="test_pool/mesh/Pool.obj" scale="1.0" convex="false"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		</physical>
		<material name="Neutral"/>
		<look name="PoolTexture"/>
		<world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
	</static>

    <static name="WindowsUp" type="model">
		<physical>
			<mesh filename="test_pool/mesh/WindowsUp.obj" scale="1.0" convex="false"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		</physical>
		<material name="Neutral"/>
		<look name="Black"/>
		<world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
	</static>

    <static name="WindowsDown" type="model">
		<physical>
			<mesh filename="test_pool/mesh/WindowsDown.obj" scale="1.0" convex="false"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		</physical>
		<material name="Neutral"/>
		<look name="Black"/>
		<world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
	</static>

    <static name="WindowsCyl" type="model">
		<physical>
			<mesh filename="test_pool/mesh/WindowsCyl.obj" scale="1.0" convex="false"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		</physical>
		<material name="Neutral"/>
		<look name="Alluminium"/>
		<world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
	</static>

	<static name="Floor" type="model">
		<physical>
			<mesh filename="test_pool/mesh/Floor.obj" scale="1.0" convex="false"/>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
		</physical>
		<material name="Neutral"/>
		<look name="Gray"/>
		<world_transform xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
	</static>




</scenario>
